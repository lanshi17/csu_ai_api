      ],
      "max_tokens": 200,
      "temperature": 0.0,
      "checks": [
        {"type": "contains_any", "values": ["machine learning"]},
        {"type": "not_contains", "values": ["机器学习"]}
      ]
    },
    {
      "id": "embed_text",
